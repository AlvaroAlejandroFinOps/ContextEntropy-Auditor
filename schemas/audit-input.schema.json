{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Entropy Auditor Input",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "role", "content"]
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["id", "content"]
      }
    },
    "tool_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "tool_name": { "type": "string" },
          "parameters": { "type": "object" },
          "result": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "tool_name", "parameters", "result"]
      }
    },
    "runtime_telemetry": {
      "type": "object",
      "additionalProperties": true
    },
    "audit_configuration": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["schema_version", "messages"]
}
