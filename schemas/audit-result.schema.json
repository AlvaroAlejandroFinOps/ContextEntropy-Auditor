{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Context Entropy Auditor Result",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "audit_version": { "type": "string" },
    "audit_id": { "type": "string" },
    "overall_status": {
      "type": "string",
      "enum": ["stable", "moderate", "high", "critical"]
    },
    "risk_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "scope": {
      "type": "object",
      "properties": {
        "messages_observed": { "type": "integer" },
        "documents_observed": { "type": "integer" },
        "tool_outputs_observed": { "type": "integer" }
      }
    },
    "dimension_scores": {
      "type": "object",
      "properties": {
        "instruction_conflict": { "type": "number", "enum": [0, 25, 50, 75, 100] },
        "task_ambiguity": { "type": "number", "enum": [0, 25, 50, 75, 100] },
        "context_contamination": { "type": "number", "enum": [0, 25, 50, 75, 100] },
        "evidence_quality": { "type": "number", "enum": [0, 25, 50, 75, 100] },
        "state_integrity": { "type": "number", "enum": [0, 25, 50, 75, 100] },
        "redundancy_pressure": { "type": "number", "enum": [0, 25, 50, 75, 100] }
      },
      "required": [
        "instruction_conflict", "task_ambiguity", "context_contamination",
        "evidence_quality", "state_integrity", "redundancy_pressure"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": { "type": "string" },
          "dimension": { "type": "string" },
          "epistemic_status": { 
            "type": "string", 
            "enum": ["observed", "inferred", "runtime_measured", "unknown"] 
          },
          "severity": { "type": "number", "enum": [0, 25, 50, 75, 100] },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "explanation": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["finding_id", "dimension", "epistemic_status", "severity", "evidence_refs", "explanation"]
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": { "type": "string" },
          "target_refs": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "requires_policy_approval": { "type": "boolean" },
          "destructive": { "type": "boolean" }
        },
        "required": ["action", "reason", "requires_policy_approval", "destructive"]
      }
    },
    "triggered_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "schema_version", "audit_id", "overall_status", "risk_score", 
    "confidence", "evidence_coverage", "dimension_scores", "findings", "limitations"
  ]
}
